# ==============================================================================
# FLOW AGENTE - CONFIGURAÇÃO GERAL
# ==============================================================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# BANCO DE DADOS (PostgreSQL Multi-tenant)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flow_agente?schema=public"

# REDIS (Filas BullMQ e Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SEGURANÇA E AUTENTICAÇÃO
JWT_SECRET=super_secret_jwt_key_flow_agente_2026
JWT_EXPIRES_IN=7d
SUPER_ADMIN_EMAIL=admin@flowagente.com
SUPER_ADMIN_PASSWORD=adminpassword123

# EVOLUTION API (Integração WhatsApp por QR Code)
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua_chave_global_da_evolution

# INTELIGÊNCIA ARTIFICIAL (Google Gemini)
GEMINI_API_KEY=sua_chave_gemini_aqui

# COBRANÇA E ASSINATURAS (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
